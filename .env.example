# Salin file ini menjadi .env lalu ubah nilainya bila perlu.
# Jangan pernah commit file .env yang berisi password asli.
POSTGRES_USER=together
POSTGRES_PASSWORD=ubah_password_ini
POSTGRES_DB=together

APP_PORT=8010
ADMINER_PORT=8090

# Isi true untuk membuat data demo saat database masih kosong.
SEED_DEMO=true

# Kredensial Redis tidak dipakai pada mode development lokal.
REDIS_URL=redis://cache:6379/0
